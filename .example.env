# Application Environment
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database Configuration (for Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=expenses_db
DB_PORT=5432

# Database URL (for Prisma - will be constructed automatically in docker-compose)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# In Docker, the host will be 'db' (the service name)
PRISMA_DATABASE_URL=postgresql://postgres:your_secure_password_here@db:5432/expenses_db?schema=public

# Auth Configuration
KEY_PAIR_ROTATION_COUNT=3
HASH_SALT=12
REFRESH_TOKEN_EXPIRATION=30D
ACCESS_TOKEN_EXPIRATION=1H
JWT_ALGORITHM=RS256

# Initial Admin User (for database seeding)
INIT_EMAIL=admin@admin.com
INIT_PASSWORD=change_this_password

# ===========================================
# IMPORTANT NOTES:
# ===========================================
# 1. Make sure POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB 
#    match the values in PRISMA_DATABASE_URL
# 
# 2. For production, use strong passwords and keep this file secure
# 
# 3. Never commit the actual .env file to version control
# 
# 4. The database host in PRISMA_DATABASE_URL should be 'db' 
#    when running with Docker Compose (it's the service name)
# ===========================================